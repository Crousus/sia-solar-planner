# Primary LLM for datasheet extraction (OpenAI-compatible DeepSeek API).
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Reasoning mode; off by default for speed (extraction doesn't need it).
# DEEPSEEK_THINKING=disabled

# Optional fallback, used only when DeepSeek fails transiently
# (429 / 5xx / timeout / empty JSON-mode response). Leave unset to disable.
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile
