# `**/` so nested dirs are excluded too — a bare `node_modules` only matches
# the context root, which let pdf-service/node_modules (host-OS binaries)
# leak into the build context and the frontend's `COPY . .`.
**/node_modules
dist
.git
server
.claude
.playwright-mcp
.worktrees
server/pb_data
server/pocketbase
*.local
# Secrets (DeepSeek/Groq keys etc.) must never end up in an image layer.
**/.env*
**/__pycache__
**/*.pyc
login*.png
newteam.png
planner-unlocked.png
teampicker*.png
teamview*.png
adr
docs
